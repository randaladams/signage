<?xml version="1.0" encoding="utf-8"?>
<!-- Only Microsoft's official feed: the build downloads the .NET runtime packs it bundles into the .exe. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
